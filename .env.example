# =============================================================================
# External Monitoring — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# ---------------------------------------------------------------------------
# Telegram Alerting (required for notifications)
# ---------------------------------------------------------------------------
# Your bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID (user, group, or channel). Use @userinfobot to find yours.
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
# Admin credentials for the Grafana UI
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme_use_strong_password

# Public URL (used in links and redirects)
GF_SERVER_ROOT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Prometheus Retention
# ---------------------------------------------------------------------------
# How long to keep metrics data
PROMETHEUS_RETENTION=30d

# Maximum disk space for metrics storage
PROMETHEUS_RETENTION_SIZE=5GB
